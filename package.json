{
  "name": "dsh-workspace-model",
  "version": "0.1.2",
  "description": "DSH workspace-specific defaults for model and reasoning",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "policy.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "dsh.plugin.json",
    "inheritance.js"
  ],
  "scripts": {
    "test": "node scripts/sync-inheritance.mjs --check && node --test",
    "sync:inheritance": "node scripts/sync-inheritance.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sth32/dsh-workspace-model.git"
  },
  "homepage": "https://github.com/Sth32/dsh-workspace-model#readme",
  "bugs": {
    "url": "https://github.com/Sth32/dsh-workspace-model/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "workspace",
    "model"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  }
}
